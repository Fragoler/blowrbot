# Production secrets for the compose stack. Copy to .env next to compose.yaml on
# the VPS and fill in. Never commit the real file.

BOT_TOKEN=
POSTGRES_PASSWORD=

# Must match [postgres] user/dbname in config.toml.
POSTGRES_USER=loudbot
POSTGRES_DB=loudbot

# Pin a specific build instead of the latest master image, e.g. sha-<commit>.
IMAGE_TAG=latest

# Secrets only. Never commit the real .env.
BOT_TOKEN=
POSTGRES_PASSWORD=

# Optional: path to the TOML config (default: ./config.toml)
CONFIG_PATH=config.toml

# Only for the goose CLI (task migrate:*). The bot itself builds its DSN from
# config.toml plus POSTGRES_PASSWORD and migrates on startup.
GOOSE_DBSTRING=postgres://loudbot:secret@localhost:5432/loudbot?sslmode=disable

# Only for task test:integration. Point it at a throwaway database — the tests
# migrate it and write into it.
# docker run --rm -d -p 55432:5432 -e POSTGRES_USER=loudbot \
#   -e POSTGRES_PASSWORD=secret -e POSTGRES_DB=loudbot postgres:17-alpine
LOUDBOT_TEST_POSTGRES=postgres://loudbot:secret@localhost:5432/loudbot?sslmode=disable
